## Chat Agent (Next.js) - Example env
##
## Copy to: chat-agent/.env.local
## Then fill values. For local Supabase values, run: `supabase status`

# Supabase (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini (from Google AI Studio)
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: model override (UI + API route)
NEXT_PUBLIC_GOOGLE_GENERATIVE_MODEL_ID=gemini-2.5-flash

# Optional: enable MCP tool mode (requires mcp-server running)
USE_MCP=false
MCP_SERVER_URL=http://localhost:4004/mcp
MCP_AUTH_TOKEN=

# Optional: used by some server-side helpers (safe to set for local)
NEXT_PUBLIC_SITE_URL=http://localhost:4000
NEXT_PUBLIC_DEV_MODE=true

